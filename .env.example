# Buy or Wait? environment template.
#
# Copy to `.env` and fill in only what you need:  `cp .env.example .env`
# `.env` is gitignored; `.env.example` must contain placeholders only.
#
# Nothing here is required.  With no variables set the assistant runs fully
# offline: deterministic decisions, local CSVs, zero model calls, no API key.
# Export these in your shell, or use a tool that loads `.env` (the code reads the
# process environment only and never parses `.env` itself).

# ---------------------------------------------------------------------------
# 1. Offline (default)
# ---------------------------------------------------------------------------
# Leave BUY_WAIT_LLM_PROVIDER unset or set it to `none` for the deterministic
# path.  All seven machine-readable decision columns are always computed in
# Python; a provider can never change them.

# BUY_WAIT_LLM_PROVIDER=none

# ---------------------------------------------------------------------------
# 2. Optional local agent (Ollama) - no key, no cloud
# ---------------------------------------------------------------------------
# Requires `ollama serve` plus `ollama pull <model>` and requirements-agent.txt.
# BUY_WAIT_LLM_PROVIDER=ollama
# BUY_WAIT_OLLAMA_MODEL=qwen2.5:1.5b
# BUY_WAIT_OLLAMA_BASE_URL=http://localhost:11434
#
# Generation settings.  The defaults are reproducible (temperature 0) and are
# what the published comparison runs used.  Raise temperature only to explore
# different local-model wording; every machine-readable field is still decided
# by the deterministic kernel, so sampling can never change a decision.
# BUY_WAIT_OLLAMA_TEMPERATURE=0        # 0 = deterministic, higher = more varied
# BUY_WAIT_OLLAMA_NUM_CTX=8192         # context window; minimum enforced is 512
# BUY_WAIT_OLLAMA_TOP_P=0.9
# BUY_WAIT_OLLAMA_TOP_K=40
# BUY_WAIT_OLLAMA_REPEAT_PENALTY=1.1
# BUY_WAIT_OLLAMA_NUM_PREDICT=1024     # cap on generated tokens per turn

# Agent behaviour.  A rejected proposal is sent back with the exact fix and
# retried up to BUY_WAIT_AGENT_REPAIR_TURNS times (default 2, max 5) before the
# kernel row stands.  BUY_WAIT_INTENT_TIMEOUT is how long the intent classifier
# may take (a cold local model can need a minute).
# BUY_WAIT_AGENT_REPAIR_TURNS=2
# BUY_WAIT_INTENT_TIMEOUT=120

# ---------------------------------------------------------------------------
# 3. Optional remote agent (OpenRouter) - hard-capped at 50 calls per run
# ---------------------------------------------------------------------------
# Privacy class: FREE.  Free tiers may train on the data they receive, so the
# TUI and code.task_agent warn before this provider sees free text.  Do not send
# account numbers, card numbers, identity documents or addresses.
# BUY_WAIT_LLM_PROVIDER=openrouter
# BUY_WAIT_LLM_MODEL=<openrouter-model-id>
# BUY_WAIT_LLM_API_KEY=<your-openrouter-api-key>
# OPENROUTER_KEY=<your-openrouter-api-key>          # optional alias
# BUY_WAIT_LLM_MAX_CALLS=50

# ---------------------------------------------------------------------------
# 3b. Paid provider - the recommended class for real user data
# ---------------------------------------------------------------------------
# Privacy class: PAID.  Your own OpenAI-compatible endpoint on no-training terms.
# The class is a declaration, not a probe: nothing here can verify an endpoint's
# terms, so point it at a URL whose terms you have actually read.
# Nothing is committed: there is no default URL, key or model, so all three are
# required.  A remote http:// URL is refused; use https (http only on loopback).
#   python -m code.task_agent "can I afford 40,000 on the 12th" --provider paid
# BUY_WAIT_LLM_PROVIDER=paid
# BUY_WAIT_PAID_BASE_URL=<your-openai-compatible-base-url>
# BUY_WAIT_PAID_API_KEY=<your-key>
# BUY_WAIT_PAID_MODEL=<model-id-you-may-call>

# Suppress the chat-provider, explanation and Jev notices in the batch pipeline
# (python -m code.main). The interactive surfaces - the TUI and python -m
# code.task_agent - always warn, and so do the embeddings index and the image
# reader: they are where a person's own text and documents leave the machine.
# BUY_WAIT_ACCEPT_FREE_TIER=1

# ---------------------------------------------------------------------------
# 4. Final deployment agent (Kilo + Nemotron Ultra) - YOU must configure this
# ---------------------------------------------------------------------------
# The repository ships no Kilo endpoint and no key.  Provide both, then opt in:
#   python -m code.agent --request-id <request_id> --provider kilo
# The provider speaks the OpenAI-compatible chat API through langchain-openai.
# OPENROUTER_KEY is never used as a fallback for Kilo.
# BUY_WAIT_LLM_PROVIDER=kilo
# BUY_WAIT_KILO_BASE_URL=<your-kilo-openai-compatible-base-url>
# BUY_WAIT_KILO_API_KEY=<your-kilo-api-key>
# BUY_WAIT_KILO_MODEL=nemotron-3-ultra
# BUY_WAIT_LLM_MAX_CALLS=50

# ---------------------------------------------------------------------------
# 5. Local vision OCR (Qwen3-VL + Docling) - no key, no cloud
# ---------------------------------------------------------------------------
# Which reader handles linked screenshots:
#   auto      Qwen3-VL -> Docling (only if configured) -> Tesseract
#   vlm       Qwen3-VL only
#   docling   Docling only
#   tesseract Tesseract only
# Every backend is local.  A non-loopback VLM host is refused unless explicitly
# allowed, so image bytes do not leave the machine by default.
# BUY_WAIT_OCR_BACKEND=auto
# BUY_WAIT_VLM_BASE_URL=http://127.0.0.1:11434
# BUY_WAIT_VLM_MODEL=qwen3-vl:2b-instruct-q4_K_M
# BUY_WAIT_VLM_TIMEOUT=180
# BUY_WAIT_VLM_ALLOW_REMOTE=0
# Docling runs in its own interpreter; leave unset to skip it.
# BUY_WAIT_DOCLING_PYTHON=<path-to-python-with-docling>
# BUY_WAIT_DOCLING_TIMEOUT=300

# ---------------------------------------------------------------------------
# 6. Local result cache - avoids repeating slow OCR/VLM work
# ---------------------------------------------------------------------------
# Entries are content-addressed and expire; an expired entry is simply a miss.
# BUY_WAIT_CACHE_DIR=data/cache
# BUY_WAIT_CACHE_TTL_DAYS=30
# BUY_WAIT_CACHE_DISABLE=1

# ---------------------------------------------------------------------------
# 7. JEV decision gate (OpenCode Zen) - audit only, never a decision source
# ---------------------------------------------------------------------------
# tools/experiments/compare_jev.py asks the typed decision model to reproduce or
# question the kernel's status/method and to rate decision safety and evidence
# sufficiency.  Machine fields are never touched.  Without a key the gate is
# simply unavailable and the comparison reports that honestly.
# OPENCODE_API_KEY=<your-opencode-api-key>            # or leave for auth.json
# OPENCODE_AUTH_JSON=<path-to-opencode-auth.json>     # default ~/.local/share/opencode/auth.json
# BUY_WAIT_JEV_BASE_URL=https://opencode.ai/inference/systemone/v1/systemone
# BUY_WAIT_JEV_MODEL=jev-1.13-free                    # free tier accepts noul questions only
# BUY_WAIT_JEV_TIMEOUT=60

# ---------------------------------------------------------------------------
# 8. OCR binary
# ---------------------------------------------------------------------------
# Path to the Tesseract executable when it is not on PATH.
# TESSERACT_CMD=<path-to-tesseract-executable>
